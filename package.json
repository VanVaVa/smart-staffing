{
  "name": "smart-staffing",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "prisma generate && next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "fsd:lint": "steiger ./src",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "sync:documents": "tsx scripts/sync-b2bcloud-documents.ts",
    "import:media": "tsx scripts/import-teamforce-media.ts",
    "db:sync-home-features": "tsx prisma/sync-home-features.ts",
    "db:sync-clients-benefits": "tsx prisma/sync-clients-platform-benefits.ts",
    "db:sync-content": "tsx prisma/sync-landing-page-from-static.ts",
    "db:studio": "prisma studio",
    "cache:images:clear": "rm -rf .next/dev/cache/images .next/cache/images",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.0",
    "@tiptap/extension-link": "^3.31.0",
    "@tiptap/react": "^3.31.0",
    "@tiptap/starter-kit": "^3.31.0",
    "bcryptjs": "^3.0.3",
    "next": "16.2.11",
    "nodemailer": "^9.1.1",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-pdf": "^10.4.1",
    "sanitize-html": "^2.17.5"
  },
  "devDependencies": {
    "@feature-sliced/steiger-plugin": "^0.7.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.1",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "prisma": "^7.9.0",
    "server-only": "^0.0.1",
    "steiger": "^0.6.0",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
