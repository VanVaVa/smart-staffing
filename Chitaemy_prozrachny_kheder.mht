@charset "utf-8";

:root { --ground: #EDEFF3; --surface: #FFFFFF; --surface-2: #F5F7FA; --ink: #14181C; --ink-2: #59636F; --line: #D8DEE5; --line-soft: #E6EAF0; --accent: #0E7C7B; --accent-soft: rgba(14,124,123,.10); --accent-ink: #FFFFFF; --code-bg: #0F1519; --code-ink: #DCE5E8; --code-dim: #7E8F95; --shadow: 0 1px 2px rgba(16,24,32,.06), 0 12px 32px -12px rgba(16,24,32,.18); }

:root:not([data-theme="light"]) { color-scheme: light; }

@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) { color-scheme: dark; --ground: #0F1216; --surface: #161A20; --surface-2: #1B2027; --ink: #E7EBF0; --ink-2: #98A3B2; --line: #29303A; --line-soft: #212832; --accent: #3ECFC8; --accent-soft: rgba(62,207,200,.13); --accent-ink: #06201F; --code-bg: #0B0E12; --code-ink: #D6DEE6; --code-dim: #6C7A85; --shadow: 0 1px 2px rgba(0,0,0,.4), 0 16px 40px -16px rgba(0,0,0,.6); }
}

:root[data-theme="dark"] { color-scheme: dark; --ground: #0F1216; --surface: #161A20; --surface-2: #1B2027; --ink: #E7EBF0; --ink-2: #98A3B2; --line: #29303A; --line-soft: #212832; --accent: #3ECFC8; --accent-soft: rgba(62,207,200,.13); --accent-ink: #06201F; --code-bg: #0B0E12; --code-ink: #D6DEE6; --code-dim: #6C7A85; --shadow: 0 1px 2px rgba(0,0,0,.4), 0 16px 40px -16px rgba(0,0,0,.6); }

* { box-sizing: border-box; }

body { margin: 0px; background: var(--ground); color: var(--ink); font-family: "Golos Text", "Segoe UI", system-ui, sans-serif; font-size: 16px; line-height: 1.6; -webkit-font-smoothing: antialiased; }

h1, h2, h3 { margin: 0px; text-wrap: balance; }

p { margin: 0px; }

:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; border-radius: 4px; }

.page { max-width: 1120px; margin: 0px auto; padding: clamp(28px, 5vw, 64px) clamp(16px, 4vw, 32px) 88px; display: flex; flex-direction: column; gap: clamp(32px, 5vw, 56px); }

.masthead { display: flex; flex-direction: column; gap: 14px; max-width: 66ch; }

.eyebrow { font-family: "JetBrains Mono", ui-monospace, Menlo, monospace; font-size: 11.5px; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent); }

.masthead h1 { font-family: Unbounded, "Golos Text", system-ui, sans-serif; font-weight: 700; font-size: clamp(1.75rem, 4.2vw, 2.5rem); letter-spacing: -0.03em; line-height: 1.12; }

.lead { color: var(--ink-2); font-size: clamp(1rem, 1.6vw, 1.075rem); }

.lab { display: grid; grid-template-columns: minmax(0px, 1fr); gap: 20px; align-items: start; }

@media (min-width: 940px) {
  .lab { grid-template-columns: minmax(0px, 1.6fr) minmax(300px, 1fr); }
}

.stagecol { display: flex; flex-direction: column; gap: 10px; min-width: 0px; }

.stage { position: relative; isolation: isolate; height: min(74vh, 560px); border-radius: 16px; overflow: hidden; border: 1px solid var(--line); box-shadow: var(--shadow); background: rgb(255, 255, 255); }

.site { position: absolute; inset: 0px; overflow-y: auto; overscroll-behavior: contain; scrollbar-width: none; z-index: 1; }

.site::-webkit-scrollbar { display: none; }

.sect { position: relative; background: var(--bg); color: var(--fg); }

.sect .in { padding: 30px 22px 36px; font-size: 14.5px; line-height: 1.6; }

.sect:first-child .in { padding-top: calc(var(--h) + 20px); }

.sect h3 { font-family: Unbounded, "Golos Text", sans-serif; font-weight: 700; letter-spacing: -0.03em; line-height: 1.12; font-size: clamp(1.15rem, 2.9vw, 1.5rem); margin-bottom: 9px; }

.sect .tag { font-family: "JetBrains Mono", monospace; font-size: 10px; letter-spacing: 0.14em; text-transform: uppercase; opacity: 0.62; display: block; margin-bottom: 11px; }

.sect p { opacity: 0.88; max-width: 46ch; }

.sect p + p { margin-top: 9px; }

@property --veilbg { syntax: "<color>"; inherits: true; initial-value: #ffffff; }

.veil { position: absolute; inset: 0px 0px auto; height: var(--h); z-index: 2; pointer-events: none; display: none; transition: --veilbg 0.18s linear; --core: color-mix(in srgb, var(--veilbg) var(--dens), transparent); }

.stage[data-veil="band"] .veil { display: block; background: linear-gradient(to bottom,
    var(--core) 0,
    var(--core) var(--fstop),
    transparent 100%); }

.stage[data-veil="halo"] .veil { display: block; background: radial-gradient(ellipse var(--sw1) var(--vh) at var(--sx1) 50%, var(--core) 0, var(--core) var(--fstop), transparent 100%),
    radial-gradient(ellipse var(--sw2) var(--vh) at var(--sx2) 50%, var(--core) 0, var(--core) var(--fstop), transparent 100%),
    radial-gradient(ellipse var(--sw3) var(--vh) at var(--sx3) 50%, var(--core) 0, var(--core) var(--fstop), transparent 100%),
    radial-gradient(ellipse var(--sw4) var(--vh) at var(--sx4) 50%, var(--core) 0, var(--core) var(--fstop), transparent 100%),
    radial-gradient(ellipse var(--sw5) var(--vh) at var(--sx5) 50%, var(--core) 0, var(--core) var(--fstop), transparent 100%),
    radial-gradient(ellipse var(--sw6) var(--vh) at var(--sx6) 50%, var(--core) 0, var(--core) var(--fstop), transparent 100%); }

.scrim { position: absolute; inset: 0px 0px auto; height: calc(var(--h) + 16px); z-index: 2; pointer-events: none; display: none; }

.stage[data-blur="on"] .scrim { display: block; }

.scrim i { position: absolute; inset: 0px; display: block; }

.scrim i:nth-child(1) { backdrop-filter: blur(calc(var(--blur)/8)); mask-image: linear-gradient(rgb(0, 0, 0) 0px, rgb(0, 0, 0) 50%, transparent 88%); }

.scrim i:nth-child(2) { backdrop-filter: blur(calc(var(--blur)/4)); mask-image: linear-gradient(rgb(0, 0, 0) 0px, rgb(0, 0, 0) 26%, transparent 62%); }

.scrim i:nth-child(3) { backdrop-filter: blur(calc(var(--blur)/2)); mask-image: linear-gradient(rgb(0, 0, 0) 0px, rgb(0, 0, 0) 12%, transparent 38%); }

.scrim i:nth-child(4) { backdrop-filter: blur(var(--blur)); mask-image: linear-gradient(rgb(0, 0, 0) 0px, transparent 24%); }

.sitehdr { position: absolute; top: 0px; left: 0px; right: 0px; z-index: 3; height: var(--h); display: flex; align-items: center; gap: 16px; padding: 0px 16px; color: var(--hdr-ink); }

.sitehdr .logo { width: 26px; height: 26px; flex: 0 0 auto; margin-right: auto; display: grid; place-items: center; font-family: Unbounded, sans-serif; font-weight: 700; font-size: 17px; color: rgb(91, 75, 232); }

.sitehdr .lnk { font-size: 13.5px; font-weight: 500; white-space: nowrap; }

@media (max-width: 620px) {
  .sitehdr .lnk.opt { display: none; }
}

.sitehdr .pill { font-size: 13px; font-weight: 600; white-space: nowrap; background: var(--hdr-ink); color: var(--bg-now); border-radius: 999px; padding: 8px 16px; }

.sitehdr .burger { width: 34px; height: 34px; flex: 0 0 auto; border-radius: 50%; background: var(--hdr-ink); color: var(--bg-now); display: grid; place-items: center; font-size: 14px; }

.hint { font-family: "JetBrains Mono", monospace; font-size: 11.5px; color: var(--ink-2); letter-spacing: 0.03em; line-height: 1.6; }

.hint b { color: var(--ink); font-weight: 500; }

.rail { background: var(--surface); border: 1px solid var(--line); border-radius: 16px; padding: 18px; display: flex; flex-direction: column; gap: 18px; box-shadow: var(--shadow); }

@media (min-width: 940px) {
  .rail { position: sticky; top: 24px; }
}

.railhead { font-family: "JetBrains Mono", monospace; font-size: 10.5px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-2); }

.modes { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }

.mode { appearance: none; font-style: inherit; font-variant: inherit; font-stretch: inherit; line-height: inherit; font-family: inherit; font-optical-sizing: inherit; font-size-adjust: inherit; font-kerning: inherit; font-feature-settings: inherit; font-variation-settings: inherit; font-language-override: inherit; font-size: 13px; font-weight: 500; text-align: left; padding: 9px 11px; border-radius: 10px; border: 1px solid var(--line); background: var(--surface-2); color: var(--ink); cursor: pointer; display: flex; flex-direction: column; gap: 2px; transition: border-color 0.15s, background 0.15s; }

.mode.wide { grid-column: 1 / -1; }

.mode small { font-family: "JetBrains Mono", monospace; font-size: 9.5px; letter-spacing: 0.09em; text-transform: uppercase; color: var(--ink-2); }

.mode:hover { border-color: var(--ink-2); }

.mode[aria-pressed="true"] { background: var(--accent); border-color: var(--accent); color: var(--accent-ink); }

.mode[aria-pressed="true"] small { color: var(--accent-ink); opacity: 0.75; }

.readout { display: flex; align-items: center; gap: 11px; padding: 10px 12px; border-radius: 10px; background: var(--surface-2); border: 1px solid var(--line); }

.swatch { width: 30px; height: 30px; border-radius: 7px; flex: 0 0 auto; border: 1px solid rgba(128, 128, 128, 0.35); background: rgb(255, 255, 255); transition: background 0.18s; }

.readout .txt { display: flex; flex-direction: column; line-height: 1.3; min-width: 0px; }

.readout .txt b { font-size: 12.5px; font-weight: 600; }

.readout .txt span { font-family: "JetBrains Mono", monospace; font-size: 11px; color: var(--ink-2); }

.sliders { display: flex; flex-direction: column; gap: 13px; }

.field { display: flex; flex-direction: column; gap: 4px; transition: opacity 0.15s; }

.field[data-off="true"] { opacity: 0.3; pointer-events: none; }

.field label { display: flex; justify-content: space-between; align-items: baseline; font-size: 13px; font-weight: 500; }

.field label b { font-family: "JetBrains Mono", monospace; font-weight: 500; font-size: 12px; color: var(--accent); font-variant-numeric: tabular-nums; }

input[type="range"] { appearance: none; width: 100%; height: 4px; border-radius: 99px; margin: 6px 0px; background: var(--line); cursor: pointer; }

input[type="range"]::-webkit-slider-thumb { appearance: none; width: 16px; height: 16px; border-radius: 50%; background: var(--surface); border: 2px solid var(--accent); box-shadow: rgba(0, 0, 0, 0.25) 0px 1px 3px; }

.toggle { display: flex; align-items: flex-start; gap: 10px; font-size: 13px; line-height: 1.35; cursor: pointer; }

.toggle input { accent-color: var(--accent); width: 16px; height: 16px; flex: 0 0 auto; margin: 2px 0px 0px; }

.toggle small { display: block; color: var(--ink-2); font-size: 11.5px; }

.codeblock { background: var(--code-bg); border-radius: 14px; border: 1px solid var(--line); overflow: hidden; }

.codebar { display: flex; align-items: center; gap: 12px; padding: 11px 14px; border-bottom: 1px solid rgba(255, 255, 255, 0.07); }

.codebar span { font-family: "JetBrains Mono", monospace; font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--code-dim); margin-right: auto; }

.copy { appearance: none; font-family: "JetBrains Mono", monospace; font-size: 12px; font-weight: 500; background: rgba(255, 255, 255, 0.08); color: var(--code-ink); border: 1px solid rgba(255, 255, 255, 0.12); border-radius: 7px; padding: 5px 11px; cursor: pointer; }

.copy:hover { background: rgba(255, 255, 255, 0.15); }

.codeblock pre { margin: 0px; padding: 16px; overflow-x: auto; font-family: "JetBrains Mono", ui-monospace, Menlo, monospace; font-size: 12.5px; line-height: 1.7; color: var(--code-ink); tab-size: 2; }

.codeblock pre code { background: none; color: inherit; padding: 0px; border-radius: 0px; font-size: inherit; }

.codeblock .c { color: var(--code-dim); }

.codeblock .p { color: rgb(127, 209, 203); }

.codeblock .v { color: rgb(242, 200, 121); }

.codeblock .k { color: rgb(232, 143, 168); }

.block { display: flex; flex-direction: column; gap: 16px; }

.block h2 { font-family: Unbounded, "Golos Text", sans-serif; font-weight: 700; font-size: 1.2rem; letter-spacing: -0.025em; }

.notegrid { display: grid; gap: 12px; grid-template-columns: repeat(auto-fit, minmax(268px, 1fr)); }

.note { background: var(--surface); border: 1px solid var(--line); border-radius: 12px; padding: 15px 16px; display: flex; flex-direction: column; gap: 7px; }

.note h3 { font-size: 14.5px; font-weight: 600; line-height: 1.35; }

.note p { font-size: 13.5px; color: var(--ink-2); line-height: 1.55; }

code { font-family: "JetBrains Mono", ui-monospace, Menlo, monospace; font-size: 12px; background: var(--accent-soft); color: var(--accent); padding: 1px 5px; border-radius: 5px; }

.tablewrap { overflow-x: auto; border: 1px solid var(--line); border-radius: 12px; background: var(--surface); }

table { border-collapse: collapse; width: 100%; min-width: 520px; font-size: 13.5px; }

th, td { text-align: left; padding: 12px 15px; border-bottom: 1px solid var(--line-soft); vertical-align: top; }

tbody tr:last-child td { border-bottom: 0px; }

th { font-family: "JetBrains Mono", monospace; font-size: 10.5px; font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink-2); border-bottom: 1px solid var(--line); }

td:first-child { color: var(--ink); font-weight: 500; width: 38%; }

td:last-child { color: var(--ink-2); }

td b { color: var(--accent); font-weight: 600; }

.foot { font-size: 12.5px; color: var(--ink-2); line-height: 1.9; border-top: 1px solid var(--line); padding-top: 16px; }

@media (prefers-reduced-motion: reduce) {
  * { transition: none !important; animation: auto ease 0s 1 normal none running none !important; }
}
